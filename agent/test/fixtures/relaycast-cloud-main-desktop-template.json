{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "relay-desktop layered agent host (dev): one x64 EC2 instance, SSM-only access",
  "Parameters": {
    "AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id"
    },
    "SubnetId": {
      "Type": "String"
    },
    "SecurityGroupId": {
      "Type": "String"
    },
    "InstanceProfileName": {
      "Type": "String"
    }
  },
  "Resources": {
    "AgentHost": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": "m7i.2xlarge",
        "IamInstanceProfile": {
          "Ref": "InstanceProfileName"
        },
        "SubnetId": {
          "Ref": "SubnetId"
        },
        "SecurityGroupIds": [
          {
            "Ref": "SecurityGroupId"
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1,
          "HttpEndpoint": "enabled"
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "VolumeSize": 200,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "UserData": "",
        "Tags": [
          {
            "Key": "relaycast:component",
            "Value": "agent-host"
          },
          {
            "Key": "relaycast:stage",
            "Value": "dev"
          },
          {
            "Key": "Name",
            "Value": "relaycast-agent-host-dev-relay-desktop"
          }
        ]
      }
    },
    "SessionDocument": {
      "Type": "AWS::SSM::Document",
      "Properties": {
        "Name": "relaycast-agent-host-dev-relay-desktop-session",
        "DocumentType": "Session",
        "DocumentFormat": "JSON",
        "Content": {
          "schemaVersion": "1.0",
          "description": "relay-desktop layered agent host (dev): sessions logged to CloudWatch",
          "sessionType": "Standard_Stream",
          "inputs": {
            "cloudWatchLogGroupName": "/relaycast-agent-host/dev/ssm-sessions",
            "cloudWatchStreamingEnabled": true,
            "cloudWatchEncryptionEnabled": false,
            "s3BucketName": "",
            "runAsEnabled": true,
            "runAsDefaultUser": "agent",
            "idleSessionTimeout": "20",
            "shellProfile": {
              "linux": "cd ~ && exec bash -l",
              "windows": ""
            }
          }
        },
        "Tags": [
          {
            "Key": "relaycast:component",
            "Value": "agent-host"
          },
          {
            "Key": "relaycast:stage",
            "Value": "dev"
          }
        ]
      }
    },
    "PatchWindow": {
      "Type": "AWS::SSM::MaintenanceWindow",
      "Properties": {
        "Name": "relaycast-agent-host-dev-relay-desktop-patch",
        "Schedule": "cron(0 10 ? * SUN *)",
        "Duration": 2,
        "Cutoff": 1,
        "AllowUnassociatedTargets": false,
        "Tags": [
          {
            "Key": "relaycast:component",
            "Value": "agent-host"
          },
          {
            "Key": "relaycast:stage",
            "Value": "dev"
          }
        ]
      }
    },
    "PatchTarget": {
      "Type": "AWS::SSM::MaintenanceWindowTarget",
      "Properties": {
        "WindowId": {
          "Ref": "PatchWindow"
        },
        "ResourceType": "INSTANCE",
        "Targets": [
          {
            "Key": "InstanceIds",
            "Values": [
              {
                "Ref": "AgentHost"
              }
            ]
          }
        ]
      }
    },
    "PatchTask": {
      "Type": "AWS::SSM::MaintenanceWindowTask",
      "Properties": {
        "WindowId": {
          "Ref": "PatchWindow"
        },
        "TaskType": "RUN_COMMAND",
        "TaskArn": "AWS-RunPatchBaseline",
        "Priority": 1,
        "MaxConcurrency": "1",
        "MaxErrors": "1",
        "Targets": [
          {
            "Key": "WindowTargetIds",
            "Values": [
              {
                "Ref": "PatchTarget"
              }
            ]
          }
        ],
        "TaskInvocationParameters": {
          "MaintenanceWindowRunCommandParameters": {
            "Parameters": {
              "Operation": [
                "Install"
              ],
              "RebootOption": [
                "RebootIfNeeded"
              ]
            }
          }
        }
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "AgentHost"
      }
    },
    "SessionDocumentName": {
      "Value": {
        "Ref": "SessionDocument"
      }
    }
  }
}
